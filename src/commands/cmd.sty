\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cmd}[Custom Commands]
\newcommand{\cbox}[1]{%
  \par
  \addvspace{\bigskipamount}%
  \noindent\makebox[\linewidth]{%
    \begingroup
    \setlength{\fboxsep}{10pt}% ← 调整这个值来控制 padding（默认是 3pt）
    \fbox{%
      \begin{varwidth}{\dimexpr 0.8\linewidth - 2\fboxsep - 2\fboxrule}%
        \centering
        #1%
      \end{varwidth}%
    }%
    \endgroup
  }%
  \par
  \addvspace{\bigskipamount}%
}
\newcommand{\sbl}{\underline{\hspace{4em}}}   % 短空白
\newcommand{\mbl}{\underline{\hspace{6em}}}   % 中空白
\newcommand{\lbl}{\underline{\hspace{8em}}}   % 长空白
\newcommand{\xlbl}{\underline{\hspace{10em}}}  % 超长空白
\newcommand{\csb}{：\sbl}
\newcommand{\cmb}{：\mbl}
\newcommand{\clb}{：\lbl}
\newcommand{\cxlb}{：\xlbl}
\newcommand{\esb}{=\sbl}
\newcommand{\emb}{=\mbl}
\newcommand{\elb}{=\lbl}
\newcommand{\exlb}{=\xlbl}
\newdimen\columnspadding
\columnspadding=3em % 左右 padding

\newcommand{\column}[1]{%
  \begingroup
  \def\sep{\hfil}%
  \hbox to \linewidth{%
    \hskip\columnspadding
    \hbox to \dimexpr\linewidth-2\columnspadding\relax{%
      #1\hfil
    }%
    \hskip\columnspadding
  }%
  \par
  \endgroup
}
\newcommand{\nl}[1]{\vspace{#1\baselineskip}}
\endinput