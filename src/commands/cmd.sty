\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cmd}[Custom Commands]
\declaretheorem[
  name=定义,
  numberwithin=chapter
]{definition}
\declaretheorem[
  name=定理,
  numberwithin=chapter
]{theorem}
\declaretheorem[
  name=推论,
  numberwithin=chapter
]{corollary}
\declaretheorem[name=引理, sibling=theorem]{lemma}
\newcommand{\flexbox}[1]{%
  \par
  \addvspace{\bigskipamount}%
  \noindent\makebox[\linewidth]{%
    \begingroup
    \setlength{\fboxsep}{10pt}% ← 调整这个值来控制 padding（默认是 3pt）
    \fbox{%
      \begin{varwidth}{\dimexpr 0.8\linewidth - 2\fboxsep - 2\fboxrule}%
        \centering
        #1%
      \end{varwidth}%
    }%
    \endgroup
  }%
  \par
  \addvspace{\bigskipamount}%
}
\definecolor{noticeboxBorder}{HTML}{3366CC}
\definecolor{noticeboxBackground}{HTML}{DDEEFF}
\newtcolorbox{notice}{
  enhanced,
  sharp corners,
  colback=noticeboxBackground,
  colframe=noticeboxBorder,
  leftrule=6pt,
  rightrule=1pt,
  toprule=1pt,
  bottomrule=1pt,
  left=12mm,
  right=4mm,
  top=3mm,
  bottom=3mm,
  overlay={
    % 左侧信息图标
    \node[
      circle,
      draw=noticeboxBorder,     % 用边框颜色描边
      fill=noticeboxBackground,               % 内部填充白色（或透明）
      line width=2pt,                  % 或用 line width=1pt 控制环的粗细
      text=noticeboxBorder,     % 图标颜色匹配边框（或保持 white，按需）
      font=\bfseries,
      inner sep=2.5pt
    ] at ([xshift=8mm]frame.west) {\faInfo};
  }
}
\crefname{theorem}{定理}{定理}
\crefname{definition}{定义}{定义}
\crefname{lemma}{引理}{引理}
\crefname{equation}{公式}{公式}
\crefname{corollary}{推论}{推论}
\crefname{proof}{证明}{证明}
